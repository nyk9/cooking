# E2Eテスト用の環境変数。これをコピーして .env.e2e を作成する（.env.e2e は gitignore 済み）。
# docker-compose.e2e.yml の Postgres に接続する。
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/cooking_test"
# Neon ではなく素の Postgres ドライバを使う（src/lib/db.ts の分岐）
DB_DRIVER="pg"
# 実APIを呼ばずモックモデルを使う（src/lib/ai.ts の分岐）
E2E_MOCK_AI="1"
# モック使用時は実際には参照されないがビルド・起動のためにダミーを設定
GOOGLE_GENERATIVE_AI_API_KEY="dummy-key-for-e2e"
